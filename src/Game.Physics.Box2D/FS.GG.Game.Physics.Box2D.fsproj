<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.GG.Game.Physics.Box2D</PackageId>
    <AssemblyName>FS.GG.Game.Physics.Box2D</AssemblyName>
    <Title>FS.GG.Game.Physics.Box2D</Title>
    <Description>Opt-in headless Box2D.NET physics runtime with fixed ticks, immutable observations and game entity IDs.</Description>
    <PackageTags>fsharp;game;physics;box2d;headless</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fsi" />
    <Compile Include="Types.fs" />
    <Compile Include="Runtime.fsi" />
    <Compile Include="Runtime.fs" />
    <Compile Include="AreaRuntime.fsi" />
    <Compile Include="AreaRuntime.fs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Game.Physics.Box2D.Tests" />
    <ProjectReference Include="../Game.Core/FS.GG.Game.Core.fsproj" />
    <PackageReference Include="Box2D.NET" />
  </ItemGroup>
</Project>
