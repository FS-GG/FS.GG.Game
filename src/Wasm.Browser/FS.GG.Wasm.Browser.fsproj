<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/wasm-shared/version.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.GG.Wasm.Browser</PackageId>
    <AssemblyName>FS.GG.Wasm.Browser</AssemblyName>
    <Title>FS.GG WebAssembly Browser Runtime</Title>
    <Description>Typed, Fable-compatible browser protocol and runtime for shared FS.GG WebAssembly guests.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fsharp;fable-javascript;webassembly;wasm;browser</PackageTags>
    <FablePackageType>library</FablePackageType>
    <Version>$(WasmSharedVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Wasm.Contracts/FS.GG.Wasm.Contracts.fsproj" Version="[$(WasmSharedVersion)]" />
    <PackageReference Include="Fable.Package.SDK" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="RuntimeProtocol.fsi" />
    <Compile Include="RuntimeProtocol.fs" />
    <Compile Include="Admission.fsi" />
    <Compile Include="Admission.fs" />
    <Compile Include="Invocation.fsi" />
    <Compile Include="Invocation.fs" />
    <Compile Include="WorkerEntry.fsi" />
    <Compile Include="WorkerEntry.fs" />
    <Compile Include="Lifecycle.fsi" />
    <Compile Include="Lifecycle.fs" />
    <Compile Include="Host.fsi" />
    <Compile Include="Host.fs" />
  </ItemGroup>

  <Target Name="CurateFableCompatibilityView" AfterTargets="CreateFablePackageFiles">
    <ItemGroup>
      <_PackageFiles Remove="@(_PackageFiles)" />
      <_PackageFiles Include="RuntimeProtocol.fsi;RuntimeProtocol.fs;Admission.fsi;Admission.fs;Invocation.fsi;Invocation.fs;WorkerEntry.fsi;WorkerEntry.fs;Lifecycle.fsi;Lifecycle.fs;Host.fsi;Host.fs">
        <Pack>true</Pack>
        <PackagePath>fable/%(Filename)%(Extension)</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="js/wasm-primitives.js">
        <Pack>true</Pack>
        <PackagePath>fable/js/wasm-primitives.js</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="Fable/FS.GG.Wasm.Browser.fsproj">
        <Pack>true</Pack>
        <PackagePath>fable/FS.GG.Wasm.Browser.fsproj</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="../../eng/wasm-shared/version.props">
        <Pack>true</Pack>
        <PackagePath>fable/eng/wasm-shared/version.props</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>

  <Target Name="PinWasmContractsPackageDependency" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                      Condition="'%(Filename)' == 'FS.GG.Wasm.Contracts'"
                                      ProjectVersion="[$(WasmSharedVersion)]" />
    </ItemGroup>
  </Target>

  <Target Name="RequireGeneratedWorkerPolicy" BeforeTargets="_GetPackageFiles">
    <Error Condition="'$(WasmWorkerPolicyRoot)' == '' Or !Exists('$(WasmWorkerPolicyRoot)/WorkerEntry.js')" Text="Pack requires the exact generated F# Worker policy in an isolated WasmWorkerPolicyRoot." />

  </Target>

  <ItemGroup Condition="'$(WasmWorkerPolicyRoot)' != ''">
    <None Include="$(WasmWorkerPolicyRoot)/**/*.js" Pack="true" PackagePath="contentFiles/any/any/_content/FS.GG.Wasm.Browser/policy/%(RecursiveDir)%(Filename)%(Extension)" PackageCopyToOutput="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="js/module-worker.mjs" Pack="true" PackagePath="contentFiles/any/any/_content/FS.GG.Wasm.Browser/module-worker.mjs" PackageCopyToOutput="true" />
    <None Include="js/worker-client.mjs" Pack="true" PackagePath="contentFiles/any/any/_content/FS.GG.Wasm.Browser/worker-client.mjs" PackageCopyToOutput="true" />
    <None Include="build/FS.GG.Wasm.Browser.targets" Pack="true" PackagePath="buildTransitive/FS.GG.Wasm.Browser.targets" />
  </ItemGroup>
</Project>
