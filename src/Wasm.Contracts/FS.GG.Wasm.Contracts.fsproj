<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.GG.Wasm.Contracts</PackageId>
    <AssemblyName>FS.GG.Wasm.Contracts</AssemblyName>
    <Title>FS.GG WebAssembly Contracts</Title>
    <Description>Typed, Fable-compatible ABI profiles and validation contracts for shared FS.GG browser WebAssembly guests.</Description>
    <PackageTags>fsharp;fable-javascript;fable-dotnet;webassembly;wasm;contracts</PackageTags>
    <FablePackageType>library</FablePackageType>
    <Version>0.1.0-source.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Package.SDK" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Contracts.fsi" />
    <Compile Include="Contracts.fs" />
  </ItemGroup>

  <Target Name="CurateFableCompatibilityView" AfterTargets="CreateFablePackageFiles">
    <ItemGroup>
      <_PackageFiles Remove="@(_PackageFiles)" />
      <_PackageFiles Include="Contracts.fsi;Contracts.fs">
        <Pack>true</Pack>
        <PackagePath>fable/%(Filename)%(Extension)</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="Fable/FS.GG.Wasm.Contracts.fsproj">
        <Pack>true</Pack>
        <PackagePath>fable/FS.GG.Wasm.Contracts.fsproj</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="compatibility-profile.v1.json" Pack="true" PackagePath="wasm-compatibility/compatibility-profile.v1.json" />
    <None Include="../../tests/Wasm.Compatibility/fixtures/baselines.v1.json" Pack="true" PackagePath="wasm-compatibility/baselines.v1.json" />
    <None Include="../../tests/Wasm.Compatibility/fixtures/expected-decisions.v1.json" Pack="true" PackagePath="wasm-compatibility/expected-decisions.v1.json" />
  </ItemGroup>
</Project>
