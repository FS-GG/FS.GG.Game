<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>fsgg-playtest</AssemblyName>
    <RootNamespace>FS.GG.Playtest</RootNamespace>
  </PropertyGroup>

  <!-- The fsgg-playtest CLI (Phase 5-6 of the playtest tooling roadmap): a separate tool that reads
       the TestSpec corpus + a proof report + a TRX. It references Game.Harness only to load and
       execute IProductionJourneyProof implementations and consume their opaque receipts in-process;
       parsing/coverage remain pure and ordinary I/O stays at the Program edge. -->
  <ItemGroup>
    <Compile Include="Manifest.fs" />
    <Compile Include="Critic.fs" />
    <Compile Include="TestSpec.fs" />
    <Compile Include="Proofs.fs" />
    <Compile Include="Coverage.fs" />
    <Compile Include="Trx.fs" />
    <Compile Include="JourneyReceiptExport.fs" />
    <Compile Include="Evidence.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Harness\FS.GG.Game.Harness.fsproj" />
  </ItemGroup>

</Project>
