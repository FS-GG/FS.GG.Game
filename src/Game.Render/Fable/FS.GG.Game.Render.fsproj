<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project is package metadata, not a second implementation project. It is packed as
    fable/FS.GG.Game.Render.fsproj beside the canonical source files selected below. The source files
    themselves come directly from src/Game.Render and are compiled into the normal .NET assembly too.
    Adapter.fs (Game.Core Grids) and DefaultKeymap.fs (KeyboardInput) stay outside this bounded view.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FS.GG.Game.Render.Fable.Metadata</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <!-- In-repo layout: the sources sit one directory up in src/Game.Render, so a repo-local Fable host (the browser
       host) references this very project and compiles exactly the files the package ships. The packed copy,
       fable/FS.GG.Game.Render.fsproj, is this file with the leading `../` dropped from each Compile item (the sources
       sit beside it there), generated at pack by src/Game.Render/FS.GG.Game.Render.fsproj. The items stay unconditional:
       Fable reads a package's project file without evaluating MSBuild conditions, so a conditional item group
       compiles nothing for a package consumer (FS.GG.Game#745). -->
  <ItemGroup>
    <Compile Include="../RendererSelection.fsi" />
    <Compile Include="../RendererSelection.fs" />
    <Compile Include="../SceneInteraction.fsi" />
    <Compile Include="../SceneInteraction.fs" />
    <Compile Include="../InputEvents.fsi" />
    <Compile Include="../InputEvents.fs" />
    <Compile Include="../InputPipeline.fsi" />
    <Compile Include="../InputPipeline.fs" />
    <Compile Include="../SceneRenderers.fsi" />
    <Compile Include="../SceneRenderers.fs" />
    <Compile Include="../RendererConformance.fsi" />
    <Compile Include="../RendererConformance.fs" />
    <Compile Include="../ThemeBaked.fs" />
    <Compile Include="../Theme.fsi" />
    <Compile Include="../Theme.fs" />
    <Compile Include="../Glyphs.fsi" />
    <Compile Include="../Glyphs.fs" />
    <Compile Include="../Symbology.fsi" />
    <Compile Include="../Symbology.fs" />
    <Compile Include="../GlyphConformance.fsi" />
    <Compile Include="../GlyphConformance.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FS.GG.UI.Scene" />
  </ItemGroup>

</Project>
