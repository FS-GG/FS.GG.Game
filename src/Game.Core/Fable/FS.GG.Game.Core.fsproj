<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project is package metadata, not a second implementation project. It is packed as
    fable/FS.GG.Game.Core.fsproj beside the canonical source files selected below. The source files
    themselves come directly from src/Game.Core and are compiled into the normal .NET assembly too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FS.GG.Game.Core.Fable.Metadata</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Primitives.fsi" />
    <Compile Include="Primitives.fs" />
    <Compile Include="SessionContract.fsi" />
    <Compile Include="SessionContract.fs" />
    <Compile Include="SessionRuntime.fsi" />
    <Compile Include="SessionRuntime.fs" />
    <Compile Include="Replay.fsi" />
    <Compile Include="Replay.fs" />
    <Compile Include="SessionOperations.fsi" />
    <Compile Include="SessionOperations.fs" />
    <Compile Include="SaveMigration.fsi" />
    <Compile Include="SaveMigration.fs" />
    <Compile Include="Geometry.fsi" />
    <Compile Include="Geometry.fs" />
    <Compile Include="Pathfinding.fsi" />
    <Compile Include="Pathfinding.fs" />
    <Compile Include="Edges.fsi" />
    <Compile Include="Edges.fs" />
    <Compile Include="Los.fsi" />
    <Compile Include="Los.fs" />
    <Compile Include="SpatialGrid.fsi" />
    <Compile Include="SpatialGrid.fs" />
    <Compile Include="Resolution.fsi" />
    <Compile Include="Resolution.fs" />
    <Compile Include="Kinematics.fsi" />
    <Compile Include="Kinematics.fs" />
  </ItemGroup>

</Project>
