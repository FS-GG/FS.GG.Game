<Project Sdk="Microsoft.NET.Sdk">

  <!-- The generated JavaScript bindings the browser host consumes (GAME-RENDER-MULTI-01.4, FS.GG.Game#730).
       The BabylonJS bindings (module Qualification.Babylon) are owned by FS.GG.Templates (template
       `fs-gg-fable-bindings`, Templates#809 / PR #812) and are not published. scripts/materialize-babylon-bindings.sh
       instantiates that template from the commit pinned in eng/babylon-bindings/pin.env under artifacts/ (git-ignored;
       nothing generated is committed), and this project compiles its Bindings.fs with the host's Fable build.

       Why a source file and not the template's packed NuGet: the archive's bytes depend on the .NET SDK that compiled it
       (SDK 10.0.401 and 10.0.403 pack different assemblies), and the NuGet lock records that content hash, so a
       committed lock cannot hold for a package built on the consumer's machine. Why not a ProjectReference to the
       generated project: the lock-range gate requires every project a lock names to be a committed project file.
       The source is nullness-oblivious generated code, so nullable analysis is off for this project only.
       Fable-only; built by scripts/test-render-browser-host.sh, not by the .NET solution. Not packed. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FS.GG.Game.Render.Browser.Bindings</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <BabylonBindingsSource Condition="'$(BabylonBindingsSource)' == ''">$(MSBuildThisFileDirectory)../../artifacts/babylon-bindings/product/src/FS.GG.Game.Render.BabylonBindings/Bindings.fs</BabylonBindingsSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(BabylonBindingsSource)" Link="generated/BabylonBindings.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

</Project>
