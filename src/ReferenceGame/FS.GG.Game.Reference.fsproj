<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AssemblyName>FS.GG.Game.Reference</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="State.fs" />
    <Compile Include="Renderers.fs" />
    <Compile Include="ExperimentalColour.fs" />
    <Compile Include="ExperimentalThemes.fs" />
    <Compile Include="ExperimentalSymbology.fs" />
    <Compile Include="ExperimentalPresetData.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Game.Harness\FS.GG.Game.Harness.fsproj" />
    <ProjectReference Include="..\Game.Render\FS.GG.Game.Render.fsproj" />
  </ItemGroup>
</Project>
