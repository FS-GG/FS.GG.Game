<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AssemblyName>FS.GG.Game.Reference</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="State.fs" />
    <Compile Include="Renderers.fs" />
    <Compile Include="Pipeline.fs" />
    <!-- EXPERIMENTAL, NOT SHIPPED (FS.GG.Game#810): the client-presentation proof. ReferenceGame is not packed. -->
    <Compile Include="ExperimentalClientPresentation.fs" />
    <Compile Include="ExperimentalPlanGame.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Game.Harness\FS.GG.Game.Harness.fsproj" />
    <ProjectReference Include="..\Game.Render\FS.GG.Game.Render.fsproj" />
  </ItemGroup>
</Project>
