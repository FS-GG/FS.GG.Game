<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <OutputPath>public/sub/app/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <PackageReference Update="FSharp.Core" Version="[10.1.302]" />
    <PackageReference Include="FS.GG.Wasm.Browser" Version="[$(WasmCandidateVersion)]" />
  </ItemGroup>
  <Target Name="RequireCandidateVersion" BeforeTargets="Restore;Build">
    <Error Condition="'$(WasmCandidateVersion)' == ''" Text="Package qualification requires the exact coherent WasmCandidateVersion." />
  </Target>
</Project>
