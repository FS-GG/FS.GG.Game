<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable><GenerateProgramFile>false</GenerateProgramFile><ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Wasm.Lifecycle.Correspondence/CorrespondenceTypes.fs" />
    <Compile Include="../../Wasm.Lifecycle.Correspondence/GeneratedTraces.fs" />
    <Compile Include="../../Wasm.Lifecycle.Correspondence/Correspondence.fs" />
    <Compile Include="../../Wasm.Lifecycle.Correspondence/InstalledHostControls.fs" />
    <Compile Include="../CompatibleTypes.fs" /><Compile Include="../GeneratedCompatibilityTraces.fs" />
    <Compile Include="../CompatibilityCorrespondence.fs" /><Compile Include="../Fixtures.fs" /><Compile Include="../BrowserBridge.fs" /><Compile Include="../Program.fs" />
    <PackageReference Include="FS.GG.Wasm.Browser" Version="[$(WasmCandidateVersion)]" />
    <PackageReference Update="FSharp.Core" Version="[10.1.401]" />
  </ItemGroup>
  <Target Name="RequireCandidateVersion" BeforeTargets="Restore;Build"><Error Condition="'$(WasmCandidateVersion)' == ''" Text="Installed qualification requires the exact coherent WasmCandidateVersion." /></Target>
</Project>
