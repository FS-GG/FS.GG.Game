<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!-- Headless Expecto suite over the Scene adapter. Pulls FS.GG.UI.Scene transitively via the
       Game.Render project reference (Skia-free), so it still runs with zero Skia — the adapter is a
       pure sim->Scene projection (ADR-0022 §2 / P4). -->
  <ItemGroup>
    <Compile Include="AdapterTests.fs" />
    <Compile Include="DefaultKeymapTests.fs" />
    <Compile Include="PortalPresentationTests.fs" />
    <Compile Include="RendererSelectionTests.fs" />
    <Compile Include="RendererRegistryTests.fs" />
    <Compile Include="RendererConformanceTests.fs" />
    <Compile Include="ScenePixelsTests.fs" />
    <Compile Include="ThemeTests.fs" />
    <Compile Include="GlyphsTests.fs" />
    <Compile Include="ExperimentalThemesTests.fs" />
    <Compile Include="SceneInteractionTests.fs" />
    <Compile Include="InputPipelineContractTests.fs" />
    <!-- The input host's pure half (FS.GG.Game#788), compiled here so .NET checks it directly. -->
    <Compile Include="..\..\src\Render.Browser\InputLayout.fsi" Link="InputLayout.fsi" />
    <Compile Include="..\..\src\Render.Browser\InputLayout.fs" Link="InputLayout.fs" />
    <Compile Include="InputLayoutTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Game.Render\FS.GG.Game.Render.fsproj" />
    <ProjectReference Include="..\..\examples\Box2D.Portals\Box2D.Portals.fsproj" />
    <ProjectReference Include="..\..\src\ReferenceGame\FS.GG.Game.Reference.fsproj" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>

</Project>
