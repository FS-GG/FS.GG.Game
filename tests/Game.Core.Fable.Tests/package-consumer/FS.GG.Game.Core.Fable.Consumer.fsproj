<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ConformancePackageVersion Condition="'$(ConformancePackageVersion)' == ''">0.13.0-m4-conformance</ConformancePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GeneratedCases.fs" />
    <Compile Include="FixtureProtocol.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FS.GG.Game.Core" Version="[$(ConformancePackageVersion)]" />
  </ItemGroup>

</Project>
