<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Same generated Babylon bindings feed as src/Render.Browser (scripts/build-babylon-bindings-feed.sh). -->
  <PropertyGroup>
    <BabylonBindingsFeed Condition="'$(BabylonBindingsFeed)' == ''">$(MSBuildThisFileDirectory)../../artifacts/babylon-bindings/feed</BabylonBindingsFeed>
    <RestoreAdditionalProjectSources Condition="Exists('$(BabylonBindingsFeed)')">$(RestoreAdditionalProjectSources);$(BabylonBindingsFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Render.Browser\FS.GG.Game.Render.Browser.fsproj" />
  </ItemGroup>

</Project>
