<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- GAME-RENDER-ADOPT-01.1 (FS.GG.Game#745): the reference game's state and renderer declaration, compiled by
         Fable from the very files the .NET reference game compiles, and the generator's sample output. -->
    <Compile Include="..\..\src\ReferenceGame\State.fs" Link="ReferenceGame\State.fs" />
    <Compile Include="..\..\src\ReferenceGame\Renderers.fs" Link="ReferenceGame\Renderers.fs" />
    <Compile Include="..\..\src\ReferenceGame\ExperimentalColour.fs" Link="ReferenceGame\ExperimentalColour.fs" />
    <Compile Include="..\..\src\ReferenceGame\ExperimentalThemes.fs" Link="ReferenceGame\ExperimentalThemes.fs" />
    <Compile Include="..\..\src\ReferenceGame\ExperimentalSymbology.fs" Link="ReferenceGame\ExperimentalSymbology.fs" />
    <Compile Include="..\..\src\ReferenceGame\ExperimentalPresetData.fs" Link="ReferenceGame\ExperimentalPresetData.fs" />
    <Compile Include="GeneratedRenderers.fs" />
    <Compile Include="RetainedSurface.fs" />
    <Compile Include="InputFixture.fs" />
    <Compile Include="InputHostSmoke.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Render.Browser\FS.GG.Game.Render.Browser.fsproj" />
  </ItemGroup>

</Project>
