<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- GAME-RENDER-ADOPT-01.1 (FS.GG.Game#745): the reference game's state and renderer declaration, compiled by
         Fable from the very files the .NET reference game compiles, and the generator's sample output. -->
    <Compile Include="..\..\src\ReferenceGame\State.fs" Link="ReferenceGame\State.fs" />
    <Compile Include="..\..\src\ReferenceGame\Renderers.fs" Link="ReferenceGame\Renderers.fs" />
    <!-- FS.GG.Game#788 PR D: the reference game's input pipeline and authority, whose admission is Game.Core's
         NetworkAdmission; its two Fable-view sources are compiled here, since the browser host's Fable view does not
         reference Game.Core. -->
    <Compile Include="..\..\src\Game.Core\SessionContract.fsi" Link="GameCore\SessionContract.fsi" />
    <Compile Include="..\..\src\Game.Core\SessionContract.fs" Link="GameCore\SessionContract.fs" />
    <Compile Include="..\..\src\Game.Core\NetworkSession.fsi" Link="GameCore\NetworkSession.fsi" />
    <Compile Include="..\..\src\Game.Core\NetworkSession.fs" Link="GameCore\NetworkSession.fs" />
    <Compile Include="..\..\src\ReferenceGame\Pipeline.fs" Link="ReferenceGame\Pipeline.fs" />
    <!-- EXPERIMENTAL, NOT SHIPPED (FS.GG.Game#810): the client-presentation proof. -->
    <Compile Include="..\..\src\ReferenceGame\ExperimentalClientPresentation.fs" Link="ReferenceGame\ExperimentalClientPresentation.fs" />
    <Compile Include="..\..\src\ReferenceGame\ExperimentalPlanGame.fs" Link="ReferenceGame\ExperimentalPlanGame.fs" />
    <Compile Include="GeneratedRenderers.fs" />
    <Compile Include="RetainedSurface.fs" />
    <Compile Include="InputHostSmoke.fs" />
    <Compile Include="InputFixture.fs" />
    <Compile Include="ReferencePipelineSmoke.fs" />
    <Compile Include="ClientPresentationSmoke.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Render.Browser\FS.GG.Game.Render.Browser.fsproj" />
  </ItemGroup>

</Project>
