    {
      "id": "FR-001",
      "title": "A clean consumer MUST restore the prepared \u0060FS.GG.Game.Harness\u0060 0.14.0 package (and its coherent Core dependency) and compile \u0060JourneyReceipt.definitionDigest\u0060, \u0060ActionCoverageReport\u0060, and \u0060Journey.checkActionCoverage\u0060. (Stories: US-001; Acceptance: AC-001)",
      "text": "A clean consumer MUST restore the prepared \u0060FS.GG.Game.Harness\u0060 0.14.0 package (and its coherent Core dependency) and compile \u0060JourneyReceipt.definitionDigest\u0060, \u0060ActionCoverageReport\u0060, and \u0060Journey.checkActionCoverage\u0060. (Stories: US-001; Acceptance: AC-001)",
      "acceptanceCriteria": [
        "AC-001"
