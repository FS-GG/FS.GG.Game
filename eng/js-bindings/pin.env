# The pinned origin of the JavaScript renderer bindings the renderer-selection browser host consumes
# (GAME-RENDER-MULTI-01.4, FS.GG.Game#730). The bindings are NOT vendored: scripts/materialize-js-bindings.sh
# instantiates the `fs-gg-fable-bindings` template from this exact FS.GG.Templates commit once per corpus
# (BabylonJS: FS.GG.Templates#809, PR #812; PixiJS: FS.GG.Templates#808, PR #814) into git-ignored directories, and
# the committed src/Render.Browser.Bindings project compiles the generated Bindings.fs files. Moving the pin is a
# deliberate change: re-run the script, regenerate the packages.lock.json beside src/Render.Browser.Bindings,
# src/Render.Browser and tests/Render.Browser.Smoke, and re-run scripts/test-render-browser-host.sh.
#
# Plain KEY=VALUE lines: read by the shell script, no quoting, no expansion.
TEMPLATES_REPOSITORY=https://github.com/FS-GG/FS.GG.Templates.git
TEMPLATES_COMMIT=1eede63cb28878d76549d949d050fdaa60b46f31

BABYLON_PROJECT_NAME=FS.GG.Game.Render.BabylonBindings
BABYLON_NPM_PACKAGE=@babylonjs/core
BABYLON_NPM_VERSION=9.33.1
BABYLON_NPM_INTEGRITY=sha512-NoIfREw4QeoXzRPpXnbUpmxxPIjuRi9iS4xFDbPgXHiLwCeHSI13DJHF8YB2gKHp6rA6T5R7BAevPvWHklvXWQ==

PIXI_PROJECT_NAME=FS.GG.Game.Render.PixiBindings
PIXI_NPM_PACKAGE=pixi.js
PIXI_NPM_VERSION=8.22.0
PIXI_NPM_INTEGRITY=sha512-QbTANHMZ751MIjLiLSUSM8a7LNMWwMIf0KbRCqlW+SPS9hNLfSVS+cl1O2SEp9g1K/wyLzj/OJHv+1TUfiPr/w==
