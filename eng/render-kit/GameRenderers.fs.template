namespace @NAMESPACE@

open Browser.Types
open FS.GG.Game.Render
open FS.GG.Game.Render.Browser
open FS.GG.UI.Scene

/// The SVG, Pixi and Babylon renderers of `@STATE@`, generated by scripts/new-game-renderers.sh
/// (FS.GG.Game, GAME-RENDER-ADOPT-01.1). Edit freely: only `view` is game-specific. Walkthrough:
/// src/Game.Render/README.md, "Three-adapter authoring path".
module @MODULE@ =

    /// The Scene size in pixels, shared by the SVG root and both canvases.
    let width = @WIDTH@
    let height = @HEIGHT@

    /// The shared Scene description of the state: every backend draws exactly this. The canvas backends draw
    /// `Rectangle`, `FilledEllipse` and `Circle` (later nodes on top) and treat `Group`, `Translate` and `Empty` as
    /// structure; any other node is counted as unsupported and skipped, so keep the view to those.
    let view (state: @STATE@) : Scene =
        ignore state // TODO: project the game state onto Scene nodes.

        {
            Nodes =
                [
                    SceneNode.Rectangle(
                        (0.0, 0.0, width, height),
                        {
                            Red = 24uy
                            Green = 28uy
                            Blue = 40uy
                            Alpha = 255uy
                        }
                    )
                ]
        }

    /// The renderer declaration: SVG, Pixi and Babylon in `container`, Pixi's late failures on `route`. Give a
    /// backend its own representation with `|> SceneRenderers.withView RendererBackend.Babylon babylonView`.
    let declare (container: HTMLElement) (route: LateFailureRoute) : SceneRenderers<@STATE@> =
        BrowserRenderers.declare container (BrowserRenderers.options "@LABEL@" width height) route view

    /// Start rendering `initial` in `container` on SVG. Switch at runtime with
    /// `driver.Dispatch(RendererMsg.SelectBackend backend)`, present a new state with
    /// `driver.Dispatch(RendererMsg.StateChanged state)`, and offer `RendererSelection.available driver.Model`.
    let start
        (container: HTMLElement)
        (initial: @STATE@)
        (onChange: RendererModel<@STATE@> -> unit)
        : RendererDriver<@STATE@> =
        let route = BrowserRenderers.route ()
        BrowserRenderers.start route (SceneRenderers.registry (declare container route)) initial onChange

    /// The conformance subject for these renderers, for a browser test: call
    /// `BrowserConformance.installContextProbe ()` first, then `RendererConformance.run`, and require
    /// `RendererConformance.failures` to be empty. `states` are at least two distinct game states; `shows` reads a
    /// backend's output back (the SVG DOM, or a pixel through `BrowserConformance.readPixel`).
    let conformance
        (container: HTMLElement)
        (states: @STATE@ list)
        (shows: ConformanceHost<@STATE@> -> RendererBackend -> @STATE@ -> Async<Result<unit, string>>)
        : ConformanceSubject<@STATE@> =
        let route = BrowserRenderers.route ()

        BrowserConformance.subject
            container
            route
            (SceneRenderers.registry (declare container route))
            RendererBackend.all
            states
            shows
