# The pinned origin of the BabylonJS Fable bindings the renderer-selection browser host consumes
# (GAME-RENDER-MULTI-01.4, FS.GG.Game#730). The bindings are NOT vendored: scripts/build-babylon-bindings-feed.sh
# instantiates the `fs-gg-fable-bindings` template from this exact FS.GG.Templates commit (FS.GG.Templates#809,
# merged as PR #812), builds and packs it, and src/Render.Browser restores the resulting .nupkg as an ordinary
# PackageReference. Moving the pin is a deliberate change: re-run the script, regenerate the packages.lock.json
# beside src/Render.Browser and tests/Render.Browser.Smoke, and re-run scripts/test-render-browser-host.sh.
#
# Plain KEY=VALUE lines: read by the shell script, no quoting, no expansion.
TEMPLATES_REPOSITORY=https://github.com/FS-GG/FS.GG.Templates.git
TEMPLATES_COMMIT=ab334e885a56aa8725f9410cf727310141cf8b99
BINDINGS_PACKAGE_ID=FS.GG.Game.Render.BabylonBindings
BINDINGS_PACKAGE_VERSION=0.1.0
BABYLON_NPM_VERSION=9.33.1
BABYLON_CORE_INTEGRITY=sha512-NoIfREw4QeoXzRPpXnbUpmxxPIjuRi9iS4xFDbPgXHiLwCeHSI13DJHF8YB2gKHp6rA6T5R7BAevPvWHklvXWQ==
