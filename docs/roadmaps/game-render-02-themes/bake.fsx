// Bake the theme presets (FS.GG.Game#795; glyph ADR D11 and Q12: presets are baked at build time and compared with a
// fresh derivation in CI). Derives every preset from its seed and algorithm list, then writes:
// - src/ReferenceGame/ExperimentalPresetData.fs: every alias's hex per preset, the data the .NET test and the browser
//   smoke compare a fresh .NET and Fable derivation with;
// - docs/roadmaps/game-render-02-themes/themes/<preset>.tokens.json: DTCG 2025.10 token files;
// - docs/roadmaps/game-render-02-themes/resolver.json: a DTCG Resolver document with a `theme` modifier;
// - docs/roadmaps/game-render-02-themes/presets.css: the CSS custom properties of every preset.
// Run after building tests/Game.Render.Tests (Debug):
//   dotnet fsi docs/roadmaps/game-render-02-themes/bake.fsx
#r "../../../tests/Game.Render.Tests/bin/Debug/net10.0/FS.GG.UI.Scene.dll"
#r "../../../tests/Game.Render.Tests/bin/Debug/net10.0/FS.GG.Game.Render.dll"
#r "../../../tests/Game.Render.Tests/bin/Debug/net10.0/FS.GG.Game.Reference.dll"
open System.IO
open FS.GG.Game.Reference.Experimental
open FS.GG.Game.Reference.Experimental.Themes

let here = __SOURCE_DIRECTORY__
let root = Path.GetFullPath(Path.Combine(here, "..", "..", ".."))
let themes = presets |> List.map deriveOrFail

let data =
    [
        yield "namespace FS.GG.Game.Reference.Experimental"
        yield ""
        yield "/// GENERATED by docs/roadmaps/game-render-02-themes/bake.fsx (FS.GG.Game#795): every alias's hex in every preset, as"
        yield "/// .NET derived it. The baked presets the design ships (glyph ADR D11, Q12); a .NET test and the browser smoke"
        yield "/// derive them again and must match byte for byte."
        yield "module PresetData ="
        yield ""
        yield "    let hexes: (string * (string * string) list) list ="
        yield "        ["
        for theme in themes do
            yield sprintf "            \"%s\"," theme.Name
            yield "            ["
            for alias, hex in hexes theme do
                yield sprintf "                \"%s\", \"%s\"" alias hex
            yield "            ]"
        yield "        ]"
    ]
File.WriteAllLines(Path.Combine(root, "src", "ReferenceGame", "ExperimentalPresetData.fs"), data)
for theme in themes do
    File.WriteAllText(Path.Combine(here, "themes", theme.Name + ".tokens.json"), toDtcg theme)
File.WriteAllText(Path.Combine(here, "resolver.json"), resolverDocument presetNames)
File.WriteAllText(Path.Combine(here, "presets.css"), (themes |> List.map cssVariables |> String.concat "\n\n") + "\n")
printfn "baked %d presets, %d aliases each" themes.Length aliasNames.Length
