// Bake production theme exports and the browser conversion-corpus digest (FS.GG.Game#795).
// First build tests/Game.Render.Tests. Invoke dotnet fsi with --reference for FS.GG.UI.Scene.dll,
// FS.GG.Game.Render.dll and Game.Render.Tests.dll from that build's output directory. Explicit references
// support isolated artifact output as well as the default bin/Debug/net10.0 layout.
// ThemeBaked.fs itself is generated by tests/Game.Render.Theme.Determinism --bake.
open System.IO
open FS.GG.Game.Render
open ThemeNumerics

let here = __SOURCE_DIRECTORY__
let root = Path.GetFullPath(Path.Combine(here, "..", "..", ".."))
let themes =
    ThemePresets.recipes |> List.map (fun (name, seed, algorithms) ->
        match Theme.create seed algorithms [] |> Result.bind (Theme.validate (ThemePresets.checks 2)) with
        | Ok theme -> theme
        | Error errors -> failwithf "%s: %A" name errors)
let digest = gridDigest referenceInput
let data =
    "namespace FS.GG.Game.Reference\n\n"
    + "/// Generated by docs/roadmaps/game-render-02-themes/bake.fsx; the browser checks this .NET digest.\n"
    + "module ThemeProofData =\n"
    + sprintf "    let gridDigest = %s\n" (fixedText 1 digest)
File.WriteAllText(Path.Combine(root, "src", "ReferenceGame", "ThemeProofData.fs"), data)
for theme in themes do
    File.WriteAllText(Path.Combine(here, "themes", Theme.name theme + ".tokens.json"), Theme.toDtcg theme)
File.WriteAllText(Path.Combine(here, "resolver.json"), Theme.dtcgResolver themes)
let css =
    themes |> List.map (fun theme ->
        sprintf "[data-fsgg-theme=\"%s\"] {\n%s\n}" (Theme.name theme)
            (Theme.cssVariables theme |> List.map (fun (name,value) -> "  " + name + ": " + value + ";") |> String.concat "\n"))
    |> String.concat "\n\n"
File.WriteAllText(Path.Combine(here, "presets.css"), css + "\n")
printfn "baked %d presets, %d colour aliases each; grid digest=%s" themes.Length (Theme.hex themes.Head).Length (fixedText 0 digest)
