{
  "name": "fsgg-glyph-themes",
  "description": "FS.GG.Game.Render glyph themes (ADR GAME-RENDER-02.4 D4)",
  "version": "2025-10-01",
  "modifiers": {
    "theme": {
      "contexts": {
        "classic": [
          {
            "$ref": "classic.tokens.json"
          }
        ],
        "light": [
          {
            "$ref": "light.tokens.json"
          }
        ],
        "highContrast": [
          {
            "$ref": "highContrast.tokens.json"
          }
        ],
        "colourBlindSafe": [
          {
            "$ref": "colourBlindSafe.tokens.json"
          }
        ],
        "monochrome": [
          {
            "$ref": "monochrome.tokens.json"
          }
        ]
      },
      "default": "classic"
    },
    "density": {
      "contexts": {
        "regular": [],
        "compact": [
          {
            "seed": {
              "density": {
                "$type": "number",
                "$value": 0.75
              }
            }
          }
        ]
      },
      "default": "regular"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/modifiers/theme"
    },
    {
      "$ref": "#/modifiers/density"
    }
  ]
}
